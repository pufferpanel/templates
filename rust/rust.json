{
  "type": "srcds",
  "display": "Rust",
  "icon": "rust",
  "data": {
    "description": {
      "type": "string",
      "value": "RUST Public Server Description",
      "display": "Server Description",
      "desc": "Server description shown on server browser",
      "required": true,
      "userEdit": true
    },
    "maxPlayers": {
      "type": "integer",
      "value": 10,
      "display": "Max Players",
      "desc": "Maximum number of players to support",
      "required": true,
      "userEdit": false
    },
    "rconPassword": {
      "type": "string",
      "value": "",
      "display": "RCON Password",
      "desc": "Password to use on RCON. CHANGE THIS",
      "required": true,
      "userEdit": true
    },
    "rconPort": {
      "type": "integer",
      "value": 28016,
      "display": "RCON Port",
      "desc": "Port to use for RCON",
      "required": true,
      "userEdit": false
    },
    "serverIdentity": {
      "type": "string",
      "value": "server1",
      "display": "Server identity",
      "desc": "Server identity to use, leave as default unless you know what you're doing",
      "required": true,
      "userEdit": false
    },
    "serverImage": {
      "type": "string",
      "value": "http://",
      "display": "Server Header Image",
      "desc": "URL For the server image banner",
      "required": true,
      "userEdit": true
    },
    "serverName": {
      "type": "string",
      "value": "RUST Public Server",
      "display": "Server Name",
      "desc": "Name of the server to use",
      "required": true,
      "userEdit": true
    },
    "seed": {
      "type": "integer",
      "value": 1234,
      "display": "Server Seed",
      "desc": "Server seed to use. It is suggested to set this to a random number so worlds are not the same.",
      "required": true,
      "userEdit": true
    },
    "serverUrl": {
      "type": "string",
      "value": "http://",
      "display": "Server Website",
      "desc": "URL for the website dedicated to this server.",
      "required": true,
      "userEdit": true
    },
    "worldSize": {
      "type": "integer",
      "value": 3000,
      "display": "World Size",
      "desc": "World size (number)",
      "required": true,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IP",
      "desc": "What IP to bind the server to",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "What port to bind the server to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "steamgamedl",
      "appId": "258550"
    },
    {
      "if": "env == 'docker'",
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 258550 +quit"
      ]
    },
    {
      "if": "!file_exists(\"server.cfg\")",
      "type": "writefile",
      "target": "server.cfg",
      "text": "server.level \"${ServerLevel}\"\nserver.seed ${ServerSeed}\nserver.worldsize ${WorldSize}\nserver.hostname \"${ServerName}\"\nserver.description \"${Description}\"\nserver.headerimage \"${ServerImage}\"\nserver.url \"${URL}\"\nserver.identity \"${ServerIdentity}\""
    }
  ],
  "run": {
    "command": "./RustDedicated -nographics -batchmode +server.port ${port} +server.maxplayers ${maxPlayers} +rcon.port ${rconPort} +rcon.password \"${rconPassword}\" +rcon.web 1",
    "stop": "quit",
    "environmentVars": {
      "LD_LIBRARY_PATH": "./RustDedicated_Data/Plugins/x86_64"
    },
    "stdin": {
      "type": "rconws",
      "port": "${rconPort}",
      "password": "${rconPassword}"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
