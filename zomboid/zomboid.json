{
  "type": "zomboid",
  "display": "Project Zomboid",
  "data": {
    "adminPassword": {
      "type": "string",
      "value": "password",
      "display": "Admin Password",
      "desc": "Password for admin account",
      "required": true,
      "userEdit": true
    },
    "memory": {
      "type": "integer",
      "value": 4096,
      "display": "Memory (MB)",
      "desc": "Memory to allocate",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 16261,
      "display": "port",
      "desc": "Base port (UDP) for server. Additional ports (TCP) beyond this will need to be opened. 1 per user.",
      "required": true,
      "userEdit": true
    },
    "serverName": {
      "type": "string",
      "value": "pufferserver",
      "display": "serverName",
      "desc": "Name of the PZ server",
      "required": false,
      "userEdit": true
    },
    "steamVAC": {
      "type": "boolean",
      "value": true,
      "display": "steamVAC",
      "desc": "Enable or disable Steam VAC",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "steamgamedl",
      "appId": "380870"
    },
    {
      "if": "env == 'docker'",
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 380870 +quit"
      ]
    },
    {
      "type": "writefile",
      "text": "{ \"mainClass\": \"zombie/network/GameServer\", \"classpath\": [ \"java/.\", \"java/projectzomboid.jar\" ], \"vmArgs\": [ \"-Djava.awt.headless=true\", \"-Xmx${memory}M\", \"-Dzomboid.steam=1\", \"-Dzomboid.znetlog=1\", \"-Djava.library.path=linux64/\", \"-Djava.security.egd=file:/dev/urandom\", \"-XX:+UseZGC\", \"-XX:-OmitStackTraceInFastThrow\"] }",
      "target": "ProjectZomboid64.json"
    },
    {
      "type": "command",
      "commands": [
        "chmod +x start-server.sh"
      ]
    }
  ],
  "run": {
    "command": "./start-server.sh -servername ${serverName} -adminpassword ${adminPassword} -steamvac ${steamVAC} -port ${port}",
    "stop": "quit",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
