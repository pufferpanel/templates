{
    "name": 
    "type": "palworld",
    "display": "Palworld - Dedicated Server",
    "data": {},
    "install": [
        {
            "if": "env == 'host'",
            "type": "steamgamedl",
            "appId": "2394010"
        },
        {
            "if": "env == 'docker'",
            "type": "command",
            "commands": [
                "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 2394010 +quit"
            ]
        },
        {
            "type": "mkdir",
            "target": "Pal/Saved/Config/LinuxServer"
        },
        {
            "type": "command",
            "commands": [
                "rm -rf .steam/sdk64"                
            ]
        },
        {
            "if": "env == 'host'",
            "type": "command",
            "commands": [
                "cp -r .steam/linux64 .steam/sdk64"
            ]
        },
        {
            "if": "env == 'docker'",
            "type": "command",
            "commands": [
                "mkdir -p .steam/sdk64",
                "cp -r linux64/steamclient.so .steam/sdk64/"
            ]
        },
        {
            "type": "command",
            "commands": [
                "cp DefaultPalWorldSettings.ini Pal/Saved/Config/LinuxServer/PalWorldSettings.ini"
            ]
        }
    ],
    "run": {
        "command": [
            {
                "command": "./Pal/Binaries/Linux/PalServer-Linux-Shipping Pal"
            }
        ],
        "stopCode": 2,
        "stdin": {
            "type": "stdin"
        }
    },
    "environment": {
        "type": "host"
    },
    "supportedEnvironments": [
        {
            "type": "host"
        },
        {
            "type": "docker",
            "image": "steamcmd/steamcmd",
            "networkMode": "host",
            "networkName": "",
            "portBindings": [],
            "bindings": {}
        }
    ]
}