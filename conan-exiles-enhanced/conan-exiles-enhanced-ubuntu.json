{
  "type": "steam",
  "display": "Conan Exiles Enhanced",
  "data": {
    "admin_password": {
      "type": "string",
      "value": "",
      "display": "Admin Password",
      "required": false,
      "userEdit": true
    },
    "manage_mods": {
      "type": "boolean",
      "value": true,
      "display": "Manage Mods with Pufferpanel",
      "desc": "Define the used Mods in \"mods.txt\"",
      "required": false,
      "userEdit": true
    },
    "max_nudity": {
      "type": "options",
      "value": "0",
      "display": "Maximum Nudity",
      "desc": "0 = None, 1 = Partial, 2 = Full",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "0",
          "display": "None"
        },
        {
          "value": "1",
          "display": "Partial"
        },
        {
          "value": "2",
          "display": "Full"
        }
      ]
    },
    "max_players": {
      "type": "integer",
      "value": 40,
      "display": "Maximum Player Count",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "Port",
      "desc": "IPv4 Server Port (UDP). Port+1 (UDP) is also used by the game.",
      "required": true,
      "userEdit": false
    },
    "pvp_enabled": {
      "type": "boolean",
      "value": false,
      "display": "PVP Enabled",
      "required": false,
      "userEdit": true
    },
    "query_port": {
      "type": "integer",
      "value": 27015,
      "display": "Query Port",
      "desc": "Steam Server Query Protocol (UDP)",
      "required": true,
      "userEdit": false
    },
    "server_message_of_the_day": {
      "type": "string",
      "value": "",
      "display": "Server Message Of The Day",
      "required": false,
      "userEdit": true
    },
    "server_name": {
      "type": "string",
      "value": "Conan Exiles Server",
      "display": "Server Name",
      "desc": "Do not use double quotes (\")",
      "required": true,
      "userEdit": true
    },
    "server_password": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "required": false,
      "userEdit": true
    }
  },
  "groups": [
    {
      "display": "Server Settings",
      "description": "",
      "variables": [
        "server_name",
        "server_password",
        "admin_password",
        "server_message_of_the_day",
        "max_nudity",
        "pvp_enabled",
        "manage_mods"
      ],
      "order": 1
    },
    {
      "display": "Runtime Attributes",
      "description": "",
      "variables": [
        "max_players",
        "port",
        "query_port"
      ],
      "order": 2
    }
  ],
  "install": [
    {
      "type": "command",
      "commands": [
        "/usr/games/steamcmd +login anonymous +quit",
        "/usr/games/steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 443030 validate +quit"
      ]
    },
    {
      "type": "writefile",
      "target": "mods.txt",
      "text": "# Conan Exiles mod list\n# Add one Steam Workshop mod ID per line.\n#\n# - Mods are loaded in the order listed here.\n# - Everything after a \"#\" is a comment. Use it to note the mod name behind the ID.\n# - A \"#\" at the start of a line disables that mod without losing its ID.\n# - Empty lines and lines without an ID are ignored.\n#\n# Examples (remove the leading \"#\" to enable):\n# 3811568075 # Ira's Ragdoll Mod\n# 3720904511\n\n"
    }
  ],
  "uninstall": null,
  "run": {
    "command": [
      {
        "command": "/pufferpanel/ConanSandbox/Binaries/Linux/ConanSandboxServer-Linux-Shipping ConanSandbox -log -Port=${port} -QueryPort=${query_port} -MaxPlayers=${max_players} -ServerName=\"${server_name}\" -MULTIHOME=0.0.0.0",
        "if": ""
      }
    ],
    "stopCode": 2,
    "pre": [
      {
        "type": "command",
        "commands": [
          "/usr/games/steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 443030 +quit"
        ]
      },
      {
        "if": "manage_mods == true",
        "type": "command",
        "commands": [
          "touch /pufferpanel/mods.txt"
        ]
      },
      {
        "if": "manage_mods == true",
        "type": "command",
        "commands": [
          "sh -c \"sed 's/#.*//; s/[[:space:]]//g; /^[0-9][0-9]*$/!d' /pufferpanel/mods.txt > /pufferpanel/mod_ids.autogenerated\""
        ]
      },
      {
        "if": "manage_mods == true",
        "type": "mkdir",
        "target": "ConanSandbox/Mods"
      },
      {
        "if": "manage_mods == true",
        "type": "writefile",
        "target": "ConanSandbox/Mods/modlist.txt",
        "text": ""
      },
      {
        "if": "manage_mods == true",
        "type": "command",
        "commands": [
          "xargs -a /pufferpanel/mod_ids.autogenerated -I {} /usr/games/steamcmd +force_install_dir /pufferpanel +login anonymous +workshop_download_item 440900 {} +quit",
          "sh -c 'xargs -a /pufferpanel/mod_ids.autogenerated -I {} find /pufferpanel/steamapps/workshop/content/440900/{} -name \"*.pak\" >> /pufferpanel/ConanSandbox/Mods/modlist.txt'"
        ]
      },
      {
        "type": "command",
        "commands": [
          "mkdir -p /pufferpanel/ConanSandbox/Saved/Config/LinuxServer",
          "touch /pufferpanel/ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
          "touch /pufferpanel/ConanSandbox/Saved/Config/LinuxServer/Engine.ini"
        ]
      },
      {
        "type": "alterfile",
        "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
        "regex": true,
        "replace": "[ServerSettings]\n",
        "search": "\\A\\z"
      },
      {
        "type": "alterfile",
        "regex": true,
        "replace": "",
        "search": "(?m)^(ServerName|ServerPassword|AdminPassword|ServerMessageOfTheDay|MaxNudity|PVPEnabled)=.*\\r?\\n?",
        "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini"
      },
      {
        "type": "alterfile",
        "replace": "[ServerSettings]\nServerPassword=${server_password}\nAdminPassword=${admin_password}\nServerMessageOfTheDay=${server_message_of_the_day}\nMaxNudity=${max_nudity}\nPVPEnabled=${pvp_enabled}",
        "search": "\\[ServerSettings\\]",
        "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
        "regex": true
      },
      {
        "type": "alterfile",
        "if": "manage_mods == true",
        "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
        "regex": true,
        "search": "(?m)^(ServerModList)=.*\\r?\\n?",
        "replace": ""
      },
      {
        "if": "manage_mods == true",
        "type": "alterfile",
        "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
        "regex": true,
        "replace": "[ServerSettings]\nServerModList=modlist.txt",
        "search": "\\[ServerSettings\\]"
      },
      {
        "type": "alterfile",
        "search": "\\A\\z",
        "file": "ConanSandbox/Saved/Config/LinuxServer/Engine.ini",
        "regex": true,
        "replace": "[OnlineSubsystem]"
      },
      {
        "type": "alterfile",
        "replace": "",
        "search": "(?m)^(AdminPassword|ServerName)=.*\\r?\\n?",
        "file": "ConanSandbox/Saved/Config/LinuxServer/Engine.ini",
        "regex": true
      },
      {
        "type": "alterfile",
        "replace": "[OnlineSubsystem]\nServerName=${server_name}",
        "search": "\\[OnlineSubsystem\\]",
        "file": "ConanSandbox/Saved/Config/LinuxServer/Engine.ini",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "bindings": {},
    "containerRoot": "",
    "image": "steamcmd/steamcmd:latest",
    "networkName": "host",
    "portBindings": []
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "bindings": {},
      "containerRoot": "",
      "image": "steamcmd/steamcmd:latest",
      "networkName": "host",
      "portBindings": []
    }
  ],
  "requirements": {},
  "stats": {
    "type": ""
  },
  "query": {
    "type": ""
  },
  "keepAlive": {
    "frequency": "",
    "command": ""
  },
  "name": "conan_exiles_enhanced"
}